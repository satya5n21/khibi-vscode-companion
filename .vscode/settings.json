{
    "typescript.tsdk": "node_modules/typescript/lib",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "files.eol": "\n",
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/node_modules": false,
        "packages/*/dist": false
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/*.vsix": true,
        "**/package-lock.json": true
    },
    "khibi.enabled": true,
    "khibi.inactivityTimeoutMinutes": 5,
    "khibi.alwaysOnTop": true,
    "khibi.windowSize": "medium",
    "khibi.soundEffects": true,
    "khibi.showDialogueBubbles": true
}