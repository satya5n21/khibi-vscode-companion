{
    "name": "@khibi/companion-app",
    "version": "1.0.0",
    "main": "dist/main/main.js",
    "scripts": {
        "build:ts": "tsc -p tsconfig.json",
        "copy:assets": "node -e \"const fs=require('fs'),path=require('path');fs.mkdirSync('dist/renderer',{recursive:true});fs.copyFileSync('src/renderer/index.html','dist/renderer/index.html');fs.copyFileSync('src/renderer/styles.css','dist/renderer/styles.css');\"",
        "build": "npm run build:ts && npm run copy:assets",
        "start": "electron ."
    },
    "dependencies": {
        "@khibi/shared": "1.0.0",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@types/node": "^20.14.0",
        "@types/ws": "^8.5.12",
        "electron": "^31.2.0",
        "typescript": "^5.5.3"
    }
}